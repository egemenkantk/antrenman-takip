rules_version = '2';

// Antrenman Takip — Firestore güvenlik kuralları
//
// Kullanıcı kimliği = telefon numarası (+90...). Sunucu, her hesaba "telefon"
// etiketini (custom claim) kendisi koyar; tarayıcı bunu değiştiremez.
// "kullanicilar" koleksiyonundaki belge kimliği de bu numaradır. Listede olmayan ya da
// pasife alınmış numara hiçbir veriye erişemez.
//
// Önemli: Firestore bir belgeyi ya tamamen gösterir ya hiç göstermez.
// Bu yüzden öğrencinin/velinin görmemesi gereken bilgiler (liste fiyatı,
// koç notları, sağlık detayları, diğer çocuklar) ayrı belgelerde tutulur ve
// öğrenci/veli bunlara erişemez. Portal (Aşama 3) için bunların özetleri
// ayrıca üretilecek.

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Yardımcılar ----------
    function girisli() {
      return request.auth != null && request.auth.token.telefon is string;
    }
    function benimId() { return request.auth.token.telefon; }
    function benimYol() { return /databases/$(database)/documents/kullanicilar/$(benimId()); }
    function ben() { return get(benimYol()).data; }
    function aktif() {
      return girisli() && exists(benimYol()) && ben().get('aktif', true) != false;
    }
    function rol(r) { return aktif() && ben().rol == r; }
    function yonetici() { return rol('yonetici'); }
    function koc() { return rol('koc'); }
    function ekip() { return yonetici() || koc(); }
    function yetkisiVar(y) { return yonetici() || (koc() && y in ben().get('ekYetkiler', [])); }

    function kisi(id) { return get(/databases/$(database)/documents/kisiler/$(id)).data; }
    // Kişinin koçu: doğrudan atanmış ya da kişinin üye olduğu grubun koçu
    function kisininKocu(id) {
      return koc() && (benimId() in kisi(id).get('kocIds', []) || benimId() in kisi(id).get('grupKocIds', []));
    }
    function kisiyeBagli(id) {
      return (rol('ogrenci') || rol('veli')) && id in ben().get('bagliKisiler', []);
    }
    function kisiyiYonetebilir(id) { return yonetici() || kisininKocu(id); }

    function degisenler() { return request.resource.data.diff(resource.data).affectedKeys(); }

    // ---------- Kullanıcılar ----------
    match /kullanicilar/{tel} {
      allow read: if (girisli() && benimId() == tel) || yonetici();
      allow write: if yonetici();
    }

    // ---------- Kurum ve şubeler ----------
    match /kurumlar/{id} {
      allow read: if aktif();
      allow write: if yonetici();
    }
    match /subeler/{id} {
      allow read: if aktif();
      allow write: if yonetici();
    }

    // ---------- Kişiler (sporcu / danışan) ----------
    match /kisiler/{kisiId} {
      // Liste sorgularında da çalışsın diye koç kontrolü belgenin kendi alanından yapılır
      allow read: if yonetici()
        || (koc() && benimId() in resource.data.get('kocIds', []))
        || (koc() && benimId() in resource.data.get('grupKocIds', []))
        || kisiyeBagli(kisiId);
      allow create: if yonetici();
      // Koç kişi kaydını güncelleyebilir ama koç atamasını, aktifliği ve kurumu değiştiremez
      allow update: if yonetici()
        || (kisininKocu(kisiId) && !degisenler().hasAny(['kocIds', 'grupKocIds', 'aktif', 'kurumId']));
      allow delete: if yonetici(); // yalnızca KVKK silme talebinde kullanılır

      // Koç/yönetici alanı: sağlık notları, koç iç notları, sakatlık ve fizyo kayıtları
      match /ozel/{belge} {
        allow read, write: if kisiyiYonetebilir(kisiId);
      }
      match /sakatliklar/{belge=**} {
        allow read, write: if kisiyiYonetebilir(kisiId);
      }

      // Öğrenci/velinin de görebildiği kayıtlar
      match /testSonuclari/{belge} {
        allow read: if kisiyiYonetebilir(kisiId) || kisiyeBagli(kisiId);
        allow write: if kisiyiYonetebilir(kisiId);
      }
      match /raporlar/{belge} {
        allow read: if kisiyiYonetebilir(kisiId) || kisiyeBagli(kisiId);
        allow write: if kisiyiYonetebilir(kisiId);
      }
      match /antrenmanKayitlari/{belge} {
        allow read: if kisiyiYonetebilir(kisiId) || kisiyeBagli(kisiId);
        allow write: if kisiyiYonetebilir(kisiId);
      }
      match /posturDegerlendirmeleri/{belge} {
        allow read, write: if kisiyiYonetebilir(kisiId);
      }

      // Wellness: koç salonda girer; öğrenci/danışan kendi telefonundan, telefonu olmayan çocuk
      // velisinin telefonundan doldurur. Kimin hesabından doldurulduğu "dolduran"da saklanır.
      match /wellness/{belge} {
        allow read: if kisiyiYonetebilir(kisiId) || kisiyeBagli(kisiId);
        allow create: if kisiyiYonetebilir(kisiId)
          || (kisiyeBagli(kisiId) && request.resource.data.dolduran == benimId());
        // Aynı gün düzeltme: yalnızca kendi doldurduğu formu
        allow update: if kisiyiYonetebilir(kisiId)
          || (kisiyeBagli(kisiId) && resource.data.dolduran == benimId()
              && request.resource.data.dolduran == benimId());
        allow delete: if kisiyiYonetebilir(kisiId);
      }

      // Ev programı: koç hazırlar, öğrenci/veli görür
      match /evProgrami/{belge} {
        allow read: if kisiyiYonetebilir(kisiId) || kisiyeBagli(kisiId);
        allow write: if kisiyiYonetebilir(kisiId);
      }
      // Ev programında "yaptım" işaretleri (gün başına bir belge)
      match /evYapilan/{tarih} {
        allow read: if kisiyiYonetebilir(kisiId) || kisiyeBagli(kisiId);
        allow create, update: if kisiyiYonetebilir(kisiId)
          || (kisiyeBagli(kisiId) && request.resource.data.dolduran == benimId());
        allow delete: if kisiyiYonetebilir(kisiId);
      }
    }

    // ---------- Gruplar ve dönemler ----------
    // Öğrenci/veli grup belgesini doğrudan okuyamaz (üye listesi diğer çocukları içerir).
    match /gruplar/{grupId} {
      allow read: if yonetici() || (koc() && benimId() in resource.data.get('kocIds', []));
      allow write: if yonetici();
    }
    match /grupDonemleri/{id} {
      allow read: if ekip();
      allow write: if yonetici();
    }

    // ---------- Program ----------
    match /programlar/{id} {
      allow read: if ekip();
      allow write: if yetkisiVar('programDuzenle');
    }

    // ---------- Etkinlikler (maç, turnuva, test günü) ----------
    match /etkinlikler/{id} {
      allow read, write: if ekip();
    }

    // ---------- Güne özel değişiklikler (tek günlük seans düzenlemesi) ----------
    match /gunOzel/{id} {
      allow read, write: if ekip();
    }

    // ---------- Seanslar (dersler) ----------
    // Grup seansları diğer çocukların katılımını içerdiği için öğrenci/veliye kapalı.
    match /seanslar/{id} {
      allow read: if yonetici()
        || (koc() && (resource.data.get('kocId', '') == benimId()
                      || benimId() in resource.data.get('kocIds', [])));
      allow create, update: if ekip();
      allow delete: if yonetici();
    }

    // ---------- Paketler ve ödemeler ----------
    // Liste fiyatı bu belgelerde durduğu için öğrenci/veli doğrudan okuyamaz.
    match /paketTanimlari/{id} {
      allow read: if ekip();
      allow write: if yonetici();
    }
    match /satilanPaketler/{id} {
      allow read: if yonetici() || kisininKocu(resource.data.kisiId);
      // Koç paket atayabilir ama kişiye özel fiyat veremez
      // Grup dönem kayıtlarını ve ek ücretleri yalnızca yönetici (ve her sabahki otomatik kontrol) açar
      allow create: if yonetici()
        || (kisininKocu(request.resource.data.kisiId)
            && request.resource.data.tur in ['bireysel', 'duet', 'trio']
            && request.resource.data.uygulananFiyat == request.resource.data.listeFiyati);
      allow update: if yonetici()
        || (kisininKocu(resource.data.kisiId)
            && !degisenler().hasAny(['uygulananFiyat', 'listeFiyati', 'fiyatNotu', 'kisiId']));
      allow delete: if yonetici();
    }
    match /odemeler/{id} {
      allow read: if yonetici() || kisininKocu(resource.data.kisiId);
      allow create: if yonetici()
        || (kisininKocu(request.resource.data.kisiId)
            && request.resource.data.tahsilEdenKocId == benimId()
            && request.resource.data.tutar is number && request.resource.data.tutar > 0
            && request.resource.data.get('silindi', false) == false);
      // Koç düzeltebilir (geçmişe kaydedilir) ama silemez; silme yöneticide ve iz bırakır
      allow update: if yonetici()
        || (kisininKocu(resource.data.kisiId)
            && !degisenler().hasAny(['silindi', 'kisiId', 'tahsilEdenKocId']));
      allow delete: if false;
    }

    // ---------- Bildirimler ----------
    match /bildirimler/{id} {
      allow read: if girisli() && resource.data.aliciKullaniciId == benimId();
      allow update: if girisli() && resource.data.aliciKullaniciId == benimId()
        && degisenler().hasOnly(['okundu']);
      allow create: if ekip();
      allow delete: if yonetici();
    }

    // ---------- Performanz yüklemeleri ----------
    match /performanzYuklemeleri/{id} {
      allow read, write: if ekip();
    }

    // ---------- Kütüphaneler ----------
    match /egzersizler/{id} { allow read: if aktif(); allow write: if yetkisiVar('programDuzenle'); }
    match /programSablonlari/{id} { allow read: if ekip(); allow write: if yetkisiVar('programDuzenle'); }
    match /testTanimlari/{id} { allow read: if aktif(); allow write: if yonetici(); }
    match /branslar/{id} { allow read: if ekip(); allow write: if yonetici(); }
    match /sakatlikTipleri/{id} { allow read: if ekip(); allow write: if yonetici(); }

    // ---------- Eski sistemden aktarılan genel veriler (gruplar, takvim) ----------
    match /aktarim/{id} {
      allow read, write: if yonetici();
    }

    // ---------- İşlem geçmişi (değiştirilemez) ----------
    match /islemGecmisi/{id} {
      allow read: if yonetici();
      allow create: if ekip() && request.resource.data.yapan == benimId();
      allow update, delete: if false;
    }

    // Tanımlanmamış her şey kapalı
  }
}
